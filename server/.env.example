# ============================================
# DonateMatch Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Get this from: https://cloud.mongodb.com
# 1. Create free cluster
# 2. Database Access > Add user
# 3. Network Access > Add IP (0.0.0.0/0 for all)
# 4. Connect > Drivers > Copy connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/donatematch?retryWrites=true&w=majority

# JWT Secret (generate a random 64-character string)
# You can generate one at: https://generate-secret.vercel.app/64
JWT_SECRET=your_super_secret_jwt_key_change_in_production_123456

# Razorpay Keys (use test keys for development)
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Email Configuration
# For Gmail: Enable 2FA, then create App Password at:
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend URL (your Vercel deployment URL)
CLIENT_URL=http://localhost:5173

